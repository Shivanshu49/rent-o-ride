# ---- Runtime -------------------------------------------------------------
NODE_ENV=development
PORT=3000
WEB_ORIGIN=http://localhost:5173
LOG_LEVEL=debug

# ---- Database ------------------------------------------------------------
# DATABASE_URL connects as app_role, the NON-superuser role that RLS applies to.
# This is the connection every request uses. See §0.3 of the build guide.
DATABASE_URL=postgresql://app_role:app_role@localhost:5433/rentoride
# DIRECT_URL is the owner connection: migrations, job workers, webhook handler,
# admin operations. It BYPASSES RLS. Never use it to serve a user request.
DIRECT_URL=postgresql://postgres:postgres@localhost:5433/rentoride

# Used by `prisma migrate dev` only — never opened by the running API.
SHADOW_DATABASE_URL=postgresql://postgres:postgres@localhost:5433/rentoride_shadow

REDIS_URL=redis://localhost:6380

# ---- Supabase (auth + storage) -------------------------------------------
# `npm run supabase:start` prints all of these. A hosted project shows them
# under Project Settings -> API.
#
# Use 127.0.0.1, NOT localhost. GoTrue puts its own external URL in the `iss`
# claim of every token it signs, and TokenVerifier checks iss on every request.
# A mismatch of spelling between the two is a 401 on every call that looks, from
# the logs, exactly like a broken signature.
SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_ANON_KEY=replace-me
SUPABASE_SERVICE_ROLE_KEY=replace-me
# jwks = asymmetric ES256, what Supabase issues today. We never hold a signing
# key, so leaking this file cannot be used to forge a token.
SUPABASE_JWT_STRATEGY=jwks
SUPABASE_JWT_ISSUER=http://127.0.0.1:54321/auth/v1
SUPABASE_JWT_AUDIENCE=authenticated
# Only needed when SUPABASE_JWT_STRATEGY=hs256 (legacy shared secret).
# SUPABASE_JWT_SECRET=

OTP_MAX_PER_HOUR=5
KYC_SIGNED_URL_TTL_SECONDS=60

# ---- Razorpay ------------------------------------------------------------
RAZORPAY_KEY_ID=rzp_test_replace_me
RAZORPAY_KEY_SECRET=replace-me
RAZORPAY_WEBHOOK_SECRET=replace-me

# ---- Quote signing -------------------------------------------------------
# Rotating this invalidates every live quote. See docs/RUNBOOK.md.
QUOTE_SIGNING_SECRET=dev-only-quote-secret-change-me-at-least-32-chars

# ---- Feature flags -------------------------------------------------------
USE_POSTGIS=true

# ---- Swagger basic auth (production only) --------------------------------
SWAGGER_USER=admin
SWAGGER_PASSWORD=
