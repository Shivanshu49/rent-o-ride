# ---- Runtime -------------------------------------------------------------
NODE_ENV=development
PORT=3000
WEB_ORIGIN=http://localhost:5173
LOG_LEVEL=debug

# ---- Database ------------------------------------------------------------
# DATABASE_URL connects as app_role, the NON-superuser role that RLS applies to.
# This is the connection every request uses. See §0.3 of the build guide.
DATABASE_URL=postgresql://app_role:app_role@localhost:5433/rentoride
# DIRECT_URL is the owner connection: migrations, job workers, webhook handler,
# admin operations. It BYPASSES RLS. Never use it to serve a user request.
DIRECT_URL=postgresql://postgres:postgres@localhost:5433/rentoride

REDIS_URL=redis://localhost:6380

# ---- Supabase (auth + storage) -------------------------------------------
SUPABASE_URL=http://localhost:54321
SUPABASE_ANON_KEY=replace-me
SUPABASE_SERVICE_ROLE_KEY=replace-me
SUPABASE_JWT_SECRET=replace-me-with-at-least-32-characters-of-secret
SUPABASE_JWT_STRATEGY=hs256

# ---- Razorpay ------------------------------------------------------------
RAZORPAY_KEY_ID=rzp_test_replace_me
RAZORPAY_KEY_SECRET=replace-me
RAZORPAY_WEBHOOK_SECRET=replace-me

# ---- Quote signing -------------------------------------------------------
# Rotating this invalidates every live quote. See docs/RUNBOOK.md.
QUOTE_SIGNING_SECRET=dev-only-quote-secret-change-me-at-least-32-chars

# ---- Feature flags -------------------------------------------------------
USE_POSTGIS=true

# ---- Swagger basic auth (production only) --------------------------------
SWAGGER_USER=admin
SWAGGER_PASSWORD=
