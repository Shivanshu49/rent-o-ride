# The API base URL the browser calls. In dev, leave it as /api and let the Vite
# proxy forward to the NestJS server (see vite.config.ts).
VITE_API_URL=/api

# Supabase is used ONLY for the auth handshake (OTP delivery, token refresh).
# The anon key is public by design. A service-role key must NEVER appear here —
# CI greps for it (Phase 12).
VITE_SUPABASE_URL=http://localhost:54321
VITE_SUPABASE_ANON_KEY=replace-me

# Razorpay publishable key id for Checkout. The secret stays on the server.
VITE_RAZORPAY_KEY_ID=rzp_test_replace_me
