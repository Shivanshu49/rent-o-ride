# The API base URL the browser calls. In dev, leave it as /api and let the Vite
# proxy forward to the NestJS server (see vite.config.ts).
VITE_API_URL=/api

# There is NO Supabase configuration here, deliberately.
#
# The anon key is a credential: anything holding it can POST /auth/v1/otp
# directly, which routes around OtpThrottleGuard and makes the per-phone limit —
# the only thing bounding our SMS bill — decoration. Send, verify, refresh and
# sign-out all go through the API, which is the only process that holds the key.
#
# scripts/check-bundle.mjs fails CI if it ever reappears in frontend/dist.

# Razorpay publishable key id for Checkout. The secret stays on the server.
VITE_RAZORPAY_KEY_ID=rzp_test_replace_me
